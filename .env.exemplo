# Copie para .env (cp .env.exemplo .env) e preencha. Nunca versione o .env.

# --- Banco (gere a senha: openssl rand -hex 16) ---
POSTGRES_USER=minhavida
POSTGRES_PASSWORD=TROQUE_ESTE_VALOR
POSTGRES_DB=db_gestao_pessoal

# --- API ---
AMBIENTE=desenvolvimento
LOG_NIVEL=INFO
# Gere: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SEGREDO=TROQUE_ESTE_VALOR
JWT_VALIDADE_MINUTOS=1440
# console: o e-mail (com o código de recuperação) vai para o log da API:
#   docker compose logs -f api
# Em produção use smtp e preencha SMTP_* (ver API/.env.exemplo).
EMAIL_MODO=console

# --- Portas e endereços (opcionais) ---
# API_PORTA=8000
# WEB_PORTA=3000
# DB_PORTA=5432
# API_WORKERS=2
# Para acessar de outro computador: API_BIND=0.0.0.0, WEB_BIND=0.0.0.0 e ajuste
# PUBLIC_API_URL (endereço da API visto pelo navegador) e WEB_ORIGEM (origem do app).
# PUBLIC_API_URL=http://localhost:8000
# WEB_ORIGEM=http://localhost:3000
