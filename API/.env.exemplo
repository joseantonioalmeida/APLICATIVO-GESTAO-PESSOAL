# Copie para .env e preencha. Nunca versione o .env.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5432/db_gestao_pessoal
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=SENHA
POSTGRES_DB=db_gestao_pessoal
AMBIENTE=desenvolvimento
LOG_NIVEL=INFO
# --- F3: identidade e acesso ---
# Gere um segredo próprio (pelo menos 32 bytes) e substitua o valor abaixo:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SEGREDO=TROQUE_ESTE_VALOR
JWT_VALIDADE_MINUTOS=1440
# console: escreve o e-mail (com o código de recuperação) no log da API.
#          Use no desenvolvimento para testar "Esqueceu a senha".
# memoria: não envia e-mail (testes). Ambos são proibidos em producao.
EMAIL_MODO=console
# Para enviar os códigos de recuperação, use EMAIL_MODO=smtp e preencha:
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORTA=587
# SMTP_SEGURANCA=starttls
# SMTP_USUARIO=USUARIO_SMTP
# SMTP_SENHA=SENHA_SMTP
# SMTP_REMETENTE=nao-responda@exemplo.com
# SMTP_TIMEOUT_S=10
# --- F9: processador de lembretes (jobs/processar_lembretes.py) ---
# LEMBRETES_INTERVALO_S=60
# LEMBRETES_LOTE=100
# LEMBRETES_JANELA_DIAS=8
# --- Clientes web (o aplicativo móvel não precisa de CORS) ---
# CORS_ORIGENS=["http://localhost:3000"]
